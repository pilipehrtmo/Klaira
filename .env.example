# Kunci API Claude. Tanpa ini, Klaira tetap jalan dengan mesin aturan sederhana.
ANTHROPIC_API_KEY=
# Model dan tingkat "effort" AI (low | medium | high)
KLAIRA_MODEL=claude-opus-5-5
KLAIRA_EFFORT=medium
# Lokasi database SQLite
KLAIRA_DB=data/klaira.db
# Isi data contoh saat database masih kosong (1 = ya)
KLAIRA_SEED_DEMO=1
